# Copy to .env to change a value. Nothing here is required: every variable has the default shown.
# Docker Compose reads .env automatically. When running the jar or the image yourself, pass these as
# environment variables. Lines are commented out so that copying the file changes nothing until you edit it.
#
# These are demo values. Change the passwords for anything that is shared or exposed beyond your machine.

# --- Database ---------------------------------------------------------------------------------
# JDBC URL of PostgreSQL. Leave unset to run on in-memory H2 (data is lost on restart).
# Docker Compose sets this itself to the bundled PostgreSQL service, so do not set it for compose.
# DB_URL=jdbc:postgresql://localhost:5432/disputes

# Database user. Default: "sa" on H2, "disputes" in compose (also used to create the PostgreSQL user).
# DB_USERNAME=disputes

# Database password. Default: empty on H2, "disputes" in compose.
# PostgreSQL only applies it when the data volume is first created; after changing it run
# "docker compose down -v" to start with a fresh volume.
# DB_PASSWORD=disputes

# --- Application ------------------------------------------------------------------------------
# Create the demo customers, accounts, transactions and disputes at startup (idempotent).
# APP_SEED_ENABLED=true

# Password of the seeded demo customers (thandi, pieter). Demo value, override it when sharing a deployment.
# APP_DEMO_PASSWORD=demo-password

# Days after posting during which a transaction can still be disputed.
# APP_DISPUTE_WINDOW_DAYS=120

# Port the application listens on inside the process or container.
# Docker Compose always uses 8080 inside the container; use APP_PORT to change the published port.
# SERVER_PORT=8080

# --- Docker Compose only ----------------------------------------------------------------------
# Host port that compose publishes the application on.
# APP_PORT=8080
