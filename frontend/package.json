{
  "name": "dispute-portal",
  "version": "0.1.0",
  "description": "Single-page app for customers to view transactions and raise and follow disputes.",
  "productName": "Dispute Portal",
  "author": "Clyde Homu",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "lint": "prettier --check \"**/*.{js,ts,vue,css,scss,html,md,json}\" && eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\" \"./tests/**/*.ts\" playwright.config.ts",
    "lint:fix": "prettier --write \"**/*.{js,ts,vue,css,scss,html,md,json}\" && eslint --fix -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\" \"./tests/**/*.ts\" playwright.config.ts",
    "type-check": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "gen:api": "openapi-typescript ../docs/openapi.yaml -o src/api/generated/schema.d.ts",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "axios": "^1.20.0",
    "pinia": "^4.1.0",
    "quasar": "^2.35.2",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/unplugin-vue-i18n": "^11.0.0",
    "@playwright/test": "^1.64.1",
    "@quasar/app-vite": "^3.10.3",
    "@quasar/vite-plugin": "^2.0.2",
    "@types/node": "^22.19.11",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.3"
  },
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
